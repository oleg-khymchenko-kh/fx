<Window x:Class="FXViewer.CalendarFindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendar" Width="820" Height="560" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox" Height="26" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="HighestOnlyBox" Content="Highest only" VerticalAlignment="Center"
                      Margin="0,0,16,0" Click="Filter_Changed" />
            <CheckBox x:Name="HighOnlyBox" Content="High impact and above" VerticalAlignment="Center"
                      Margin="0,0,16,0" Click="Filter_Changed" />
            <TextBlock x:Name="CountText" Foreground="Gray" VerticalAlignment="Center" />
        </StackPanel>

        <ListView x:Name="EventsList" Grid.Row="2" SelectionMode="Single"
                  SelectionChanged="EventsList_SelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="EventRow_Click" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time (UTC)" Width="150" DisplayMemberBinding="{Binding Time}" />
                    <GridViewColumn Header="Cur" Width="46" DisplayMemberBinding="{Binding Currency}" />
                    <GridViewColumn Header="Impact" Width="70" DisplayMemberBinding="{Binding Impact}" />
                    <GridViewColumn Header="Event" Width="300" DisplayMemberBinding="{Binding Event}" />
                    <GridViewColumn Header="Actual" Width="70" DisplayMemberBinding="{Binding Actual}" />
                    <GridViewColumn Header="Forecast" Width="70" DisplayMemberBinding="{Binding Forecast}" />
                    <GridViewColumn Header="Previous" Width="70" DisplayMemberBinding="{Binding Previous}" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="HintText" Grid.Row="3" Margin="0,8,0,0" Foreground="Gray"
                   Text="Click a row to move the chart to that moment." />
    </Grid>
</Window>
