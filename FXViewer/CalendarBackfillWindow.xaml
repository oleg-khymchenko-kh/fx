<Window x:Class="FXViewer.CalendarBackfillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backfill calendar" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Width="380" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel Margin="16">
        <TextBlock Text="Reads Forex Factory week pages and merges them into the store. Whole weeks are fetched, so the range is widened to week boundaries."
                   Foreground="Gray" Margin="0,0,0,12" TextWrapping="Wrap" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="From" VerticalAlignment="Center"
                       Margin="0,0,10,8" />
            <TextBox x:Name="FromBox" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,0,8"
                     VerticalContentAlignment="Center" TextChanged="Range_Changed" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="To" VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <TextBox x:Name="ToBox" Grid.Row="1" Grid.Column="1" Height="26"
                     VerticalContentAlignment="Center" TextChanged="Range_Changed" />
        </Grid>

        <TextBlock x:Name="SummaryText" Foreground="Gray" Margin="0,0,0,14" TextWrapping="Wrap" />

        <DockPanel LastChildFill="False">
            <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="Cancel" Width="90" Height="28"
                    IsCancel="True" Click="CancelBtn_Click" />
            <Button x:Name="OkBtn" DockPanel.Dock="Right" Content="Start" Width="90" Height="28"
                    Margin="0,0,8,0" IsDefault="True" Click="OkBtn_Click" />
        </DockPanel>
    </StackPanel>
</Window>
