<Window x:Class="FXViewer.SymbolEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add symbol" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Width="420"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,0,10,10" />
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"><Run Text="Type" /><Run Text=" *" Foreground="#D32F2F" /></TextBlock>
        <ComboBox x:Name="TypeBox" Grid.Row="1" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,10"
                  SelectionChanged="TypeBox_SelectionChanged" />

        <TextBlock x:Name="SourceLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"><Run Text="Source" /><Run Text=" *" Foreground="#D32F2F" /></TextBlock>
        <ComboBox x:Name="SourceBox" Grid.Row="2" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,10" />

        <StackPanel x:Name="ZigZagParams" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Limit 1, pips" VerticalAlignment="Center" Width="90" />
                <TextBox x:Name="Limit1Box" Width="60" Height="26" VerticalContentAlignment="Center" />
                <TextBlock Text="reversal threshold" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="Gray" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Limit 2, pips" VerticalAlignment="Center" Width="90" />
                <TextBox x:Name="Limit2Box" Width="60" Height="26" VerticalContentAlignment="Center" />
                <TextBlock Text="pullback inside a trend" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="Gray" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Delay, min" VerticalAlignment="Center" Width="90" />
                <TextBox x:Name="Limit2DelayBox" Width="60" Height="26" VerticalContentAlignment="Center" />
                <TextBlock Text="trading minutes, top to pullback low" VerticalAlignment="Center"
                           Margin="10,0,0,0" Foreground="Gray" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="AverageParams" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Period" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="PeriodBox" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="UnitBox" Width="90" Height="26" VerticalContentAlignment="Center" Margin="8,0,0,0" />
                <ComboBox x:Name="DirectionBox" Width="90" Height="26" VerticalContentAlignment="Center" Margin="8,0,0,0" />
                <CheckBox x:Name="WeightedBox" Content="Volume weighted" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
            <CheckBox x:Name="TimeWindowBox" Content="Window by time" Margin="0,8,0,0" />
            <TextBlock Text="count the window in trading minutes back, not in stored candles"
                       Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="BandParams" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Count" VerticalAlignment="Center" Width="60" />
                <TextBox x:Name="BandCountBox" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="BandModeBox" Width="90" Height="26" VerticalContentAlignment="Center"
                          Margin="8,0,0,0" />
                <TextBlock Text="value of all the averages" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="Gray" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Step" VerticalAlignment="Center" Width="60" />
                <TextBox x:Name="BandPeriodBox" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="BandUnitBox" Width="90" Height="26" VerticalContentAlignment="Center"
                          Margin="8,0,0,0" />
                <TextBlock x:Name="BandHint" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" />
            </StackPanel>
            <CheckBox x:Name="BandTimeWindowBox" Content="Window by time" Margin="0,8,0,0" />
            <TextBlock Text="count every window in trading minutes back, not in stored candles"
                       Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="LevelsParams" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Lookback" VerticalAlignment="Center" Width="70" />
                <TextBox x:Name="LevelPeriodBox" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="LevelUnitBox" Width="90" Height="26" VerticalContentAlignment="Center"
                          Margin="8,0,0,0" />
                <TextBlock Text="back from the cursor" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="Gray" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Length" VerticalAlignment="Center" Width="70" />
                <TextBox x:Name="LevelLengthBox" Width="60" Height="26" VerticalContentAlignment="Center" />
                <TextBlock Text="Step" VerticalAlignment="Center" Margin="14,0,10,0" />
                <TextBox x:Name="LevelStepBox" Width="60" Height="26" VerticalContentAlignment="Center" />
                <TextBlock Text="pixels" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" />
            </StackPanel>
            <TextBlock Text="dashes at the right edge, one offset per trend; each older trend moves Step pixels left"
                       Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="EntryParams" Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Stop loss, pips" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="StopLossBox" Width="60" Height="26" VerticalContentAlignment="Center" />
            <TextBlock Text="Take profit, pips" VerticalAlignment="Center" Margin="14,0,10,0" />
            <TextBox x:Name="TakeProfitBox" Width="60" Height="26" VerticalContentAlignment="Center" />
        </StackPanel>

        <Grid x:Name="ShiftParams" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Target" VerticalAlignment="Center" Margin="0,8,8,0" />
            <ComboBox x:Name="TargetBox" Grid.Row="3" Grid.Column="1" Width="115" Height="26"
                      VerticalContentAlignment="Center" Margin="0,8,8,0" />
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source time" VerticalAlignment="Center" Margin="0,0,8,6" />
            <DatePicker x:Name="SourceDate" Grid.Row="0" Grid.Column="1" Width="115" Height="26" Margin="0,0,8,6" />
            <TextBox x:Name="SourceTimeBox" Grid.Row="0" Grid.Column="2" Width="60" Height="26"
                     VerticalContentAlignment="Center" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Chart time" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker x:Name="ChartDate" Grid.Row="1" Grid.Column="1" Width="115" Height="26" Margin="0,0,8,0" />
            <TextBox x:Name="ChartTimeBox" Grid.Row="1" Grid.Column="2" Width="60" Height="26"
                     VerticalContentAlignment="Center" />
            <CheckBox x:Name="FlipBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                      Content="Flip vertically (min up, max down)" Margin="0,8,0,0" />
        </Grid>

        <Grid x:Name="IndexParams" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Start" VerticalAlignment="Center" Margin="0,0,8,6" />
            <DatePicker x:Name="IndexStartDate" Grid.Row="0" Grid.Column="1" Width="115" Height="26" Margin="0,0,8,6" />
            <TextBox x:Name="IndexStartTimeBox" Grid.Row="0" Grid.Column="2" Width="60" Height="26"
                     VerticalContentAlignment="Center" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="End" VerticalAlignment="Center" Margin="0,0,8,6" />
            <DatePicker x:Name="IndexEndDate" Grid.Row="1" Grid.Column="1" Width="115" Height="26" Margin="0,0,8,6" />
            <TextBox x:Name="IndexEndTimeBox" Grid.Row="1" Grid.Column="2" Width="60" Height="26"
                     VerticalContentAlignment="Center" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Method" VerticalAlignment="Center" Margin="0,0,8,6" />
            <ComboBox x:Name="MethodBox" Grid.Row="2" Grid.Column="1" Width="115" Height="26"
                      VerticalContentAlignment="Center" Margin="0,0,0,6" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Algorithm" VerticalAlignment="Center" Margin="0,0,8,6" />
            <ComboBox x:Name="AlgorithmBox" Grid.Row="3" Grid.Column="1" Width="115" Height="26"
                      VerticalContentAlignment="Center" Margin="0,0,0,6" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Pairs" VerticalAlignment="Top" Margin="0,4,8,0" />
            <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="6,4,6,4">
                <UniformGrid x:Name="PairsPanel" Columns="2" />
            </Border>
            <CheckBox x:Name="IndexMirrorBox" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                      Content="Mirror (min up, max down)" Margin="0,8,0,0" />
        </Grid>

        <StackPanel x:Name="CurrencyParams" Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Pair" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="CurrencyPairBox" Width="110" Height="26" VerticalContentAlignment="Center"
                      SelectionChanged="CurrencyPairBox_SelectionChanged" />
            <TextBlock x:Name="CurrencyHint" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" />
        </StackPanel>

        <Grid x:Name="DealsParams" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DealsFileBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center"
                     Margin="0,0,8,0" />
            <Button x:Name="DealsBrowseBtn" Grid.Column="1" Content="Browse..." Width="80" Height="26"
                    Click="DealsBrowseBtn_Click" />
        </Grid>

        <StackPanel x:Name="DensityParams" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <StackPanel x:Name="VolumeParams" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Group, min" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="VolumeGroupBox" Width="60" Height="26" VerticalContentAlignment="Center" />
                <CheckBox x:Name="VolumeLockBox" Content="Lock (Alt+wheel does not change it)"
                          VerticalAlignment="Center" Margin="14,0,0,0" />
                <CheckBox x:Name="VolumeSplitBox" Content="Split ask / bid by color"
                          VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Key 1" VerticalAlignment="Center" Width="50" />
                <TextBox x:Name="Density1Box" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="Density1Unit" Width="90" Height="26" VerticalContentAlignment="Center"
                          Margin="8,0,0,0" />
                <TextBox x:Name="Density1Pct" Width="50" Height="26" VerticalContentAlignment="Center"
                         Margin="12,0,0,0" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Key 2" VerticalAlignment="Center" Width="50" />
                <TextBox x:Name="Density2Box" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="Density2Unit" Width="90" Height="26" VerticalContentAlignment="Center"
                          Margin="8,0,0,0" />
                <TextBox x:Name="Density2Pct" Width="50" Height="26" VerticalContentAlignment="Center"
                         Margin="12,0,0,0" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Key 3" VerticalAlignment="Center" Width="50" />
                <TextBox x:Name="Density3Box" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="Density3Unit" Width="90" Height="26" VerticalContentAlignment="Center"
                          Margin="8,0,0,0" />
                <TextBox x:Name="Density3Pct" Width="50" Height="26" VerticalContentAlignment="Center"
                         Margin="12,0,0,0" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Key 4" VerticalAlignment="Center" Width="50" />
                <TextBox x:Name="Density4Box" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="Density4Unit" Width="90" Height="26" VerticalContentAlignment="Center"
                          Margin="8,0,0,0" />
                <TextBox x:Name="Density4Pct" Width="50" Height="26" VerticalContentAlignment="Center"
                         Margin="12,0,0,0" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Key 5" VerticalAlignment="Center" Width="50" />
                <TextBox x:Name="Density5Box" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="Density5Unit" Width="90" Height="26" VerticalContentAlignment="Center"
                          Margin="8,0,0,0" />
                <TextBox x:Name="Density5Pct" Width="50" Height="26" VerticalContentAlignment="Center"
                         Margin="12,0,0,0" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Key 6" VerticalAlignment="Center" Width="50" />
                <TextBox x:Name="Density6Box" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="Density6Unit" Width="90" Height="26" VerticalContentAlignment="Center"
                          Margin="8,0,0,0" />
                <TextBox x:Name="Density6Pct" Width="50" Height="26" VerticalContentAlignment="Center"
                         Margin="12,0,0,0" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Key 7" VerticalAlignment="Center" Width="50" />
                <TextBox x:Name="Density7Box" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="Density7Unit" Width="90" Height="26" VerticalContentAlignment="Center"
                          Margin="8,0,0,0" />
                <TextBox x:Name="Density7Pct" Width="50" Height="26" VerticalContentAlignment="Center"
                         Margin="12,0,0,0" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Key 8" VerticalAlignment="Center" Width="50" />
                <TextBox x:Name="Density8Box" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="Density8Unit" Width="90" Height="26" VerticalContentAlignment="Center"
                          Margin="8,0,0,0" />
                <TextBox x:Name="Density8Pct" Width="50" Height="26" VerticalContentAlignment="Center"
                         Margin="12,0,0,0" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Key 9" VerticalAlignment="Center" Width="50" />
                <TextBox x:Name="Density9Box" Width="60" Height="26" VerticalContentAlignment="Center" />
                <ComboBox x:Name="Density9Unit" Width="90" Height="26" VerticalContentAlignment="Center"
                          Margin="8,0,0,0" />
                <TextBox x:Name="Density9Pct" Width="50" Height="26" VerticalContentAlignment="Center"
                         Margin="12,0,0,0" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Key 0" VerticalAlignment="Center" Width="50" />
                <TextBlock Text="all history" VerticalAlignment="Center" Width="158"
                           Foreground="Gray" />
                <TextBox x:Name="Density0Pct" Width="50" Height="26" VerticalContentAlignment="Center"
                         Margin="12,0,0,0" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <TextBlock Text="lookback per option, keys 1-9 switch on the chart, 0 = all history"
                       Margin="0,6,0,0" Foreground="Gray" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Scale" VerticalAlignment="Center" Width="50" />
                <TextBox x:Name="DensityScaleBox" Width="90" Height="26"
                         VerticalContentAlignment="Center" />
                <TextBlock x:Name="DensityScaleHint" Text="per pixel" VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="right-edge bar length; empty = fit the window. Ctrl+wheel on the chart row changes it, the percents above shrink it per key"
                       Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="ColorLabel" Grid.Row="4" Grid.Column="0" Text="Color"
                   VerticalAlignment="Top" Margin="0,2,10,10" />
        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="3">
                <UniformGrid x:Name="ColorPanel" Rows="4" HorizontalAlignment="Left" />
            </Border>
            <StackPanel x:Name="SellColorBlock" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock x:Name="SellColorLabel" Text="Sell color" Margin="0,0,0,4" />
                <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="3">
                    <UniformGrid x:Name="SellColorPanel" Rows="4" HorizontalAlignment="Left" />
                </Border>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="ProgressPanel" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" Text="Working..." Margin="0,0,0,4" Foreground="Gray" />
            <ProgressBar x:Name="ProgressBar" Height="16" Minimum="0" Maximum="100" />
        </StackPanel>

        <DockPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" LastChildFill="False">
            <Button x:Name="RefreshBtn" DockPanel.Dock="Left" Content="Refresh" Width="90" Height="28"
                    Click="RefreshBtn_Click" />
            <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="Cancel" Width="90" Height="28"
                    Click="CancelBtn_Click" />
            <Button x:Name="OkBtn" DockPanel.Dock="Right" Content="OK" Width="90" Height="28" Margin="0,0,8,0"
                    IsDefault="True" Click="OkBtn_Click" />
        </DockPanel>
    </Grid>
</Window>
