<Window x:Class="FXViewer.LevelParamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Level parameters" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel Margin="16">
        <TextBlock Foreground="Gray" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"
                   Margin="0,0,0,10"
                   Text="The same tables a Levels2 indicator uses. A swing is a level only when the move into it is at least the smallest left pips and the reversal after it is at least the smallest right pips. The pixels give the weight of a level in the search picture." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Text="Left part" FontWeight="SemiBold" />
                <TextBlock Text="move into the level" Foreground="Gray" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="pips" Width="64" Foreground="Gray" />
                    <TextBlock Text="pixels" Width="64" Foreground="Gray" />
                </StackPanel>
                <StackPanel x:Name="LeftRows" />
                <Button x:Name="LeftAddBtn" Content="Add row" Width="80" Height="24"
                        HorizontalAlignment="Left" Margin="0,4,0,0" Click="LeftAddBtn_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Right part" FontWeight="SemiBold" />
                <TextBlock Text="reversal after the level" Foreground="Gray" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="pips" Width="64" Foreground="Gray" />
                    <TextBlock Text="pixels" Width="64" Foreground="Gray" />
                </StackPanel>
                <StackPanel x:Name="RightRows" />
                <Button x:Name="RightAddBtn" Content="Add row" Width="80" Height="24"
                        HorizontalAlignment="Left" Margin="0,4,0,0" Click="RightAddBtn_Click" />
            </StackPanel>
        </Grid>
        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="DefaultsBtn" DockPanel.Dock="Left" Content="Defaults" Width="90" Height="28"
                    Click="DefaultsBtn_Click" />
            <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="Cancel" Width="90" Height="28"
                    IsCancel="True" Click="CancelBtn_Click" />
            <Button x:Name="OkBtn" DockPanel.Dock="Right" Content="OK" Width="90" Height="28"
                    Margin="0,0,8,0" IsDefault="True" Click="OkBtn_Click" />
        </DockPanel>
    </StackPanel>
</Window>
