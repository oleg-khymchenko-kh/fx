<Window x:Class="FXViewer.CalendarSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendar settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Width="340" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel Margin="16">
        <TextBlock Text="Which events are drawn on the chart."
                   Foreground="Gray" Margin="0,0,0,12" TextWrapping="Wrap" />

        <CheckBox x:Name="RateBox" Content="Rate decision (USD Federal Funds Rate)" Margin="0,0,0,8" />
        <CheckBox x:Name="HighBox" Content="High impact" Margin="0,0,0,8" />
        <CheckBox x:Name="MediumBox" Content="Medium impact" Margin="0,0,0,8" />
        <CheckBox x:Name="LowBox" Content="Low impact" Margin="0,0,0,8" />
        <CheckBox x:Name="HolidayBox" Content="Holidays" Margin="0,0,0,14" />

        <CheckBox x:Name="AnyZoomBox" Content="Show at any zoom" Margin="0,0,0,4" />
        <TextBlock Text="Off: lines appear only when the hourly grid is visible."
                   Foreground="Gray" Margin="20,0,0,14" TextWrapping="Wrap" />

        <DockPanel LastChildFill="False">
            <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="Cancel" Width="90" Height="28"
                    IsCancel="True" Click="CancelBtn_Click" />
            <Button x:Name="OkBtn" DockPanel.Dock="Right" Content="OK" Width="90" Height="28"
                    Margin="0,0,8,0" IsDefault="True" Click="OkBtn_Click" />
        </DockPanel>
    </StackPanel>
</Window>
