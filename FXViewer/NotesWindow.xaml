<Window x:Class="FXViewer.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notes" Width="640" Height="420" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="NotesList" Grid.Row="0" SelectionMode="Single"
                  SelectionChanged="NotesList_SelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="NoteRow_Click" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Start (UTC)" Width="160" DisplayMemberBinding="{Binding Start}" />
                    <GridViewColumn Header="End (UTC)" Width="160" DisplayMemberBinding="{Binding End}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="CreateBtn" Content="Create from tab" Width="130" Height="28"
                    Margin="0,0,8,0" Click="CreateBtn_Click" />
            <Button x:Name="UpdateBtn" Content="Update from tab" Width="130" Height="28"
                    Margin="0,0,8,0" Click="UpdateBtn_Click" />
            <Button x:Name="RenameBtn" Content="Rename..." Width="100" Height="28"
                    Margin="0,0,8,0" Click="RenameBtn_Click" />
            <Button x:Name="DeleteBtn" Content="Delete" Width="100" Height="28"
                    Click="DeleteBtn_Click" />
        </StackPanel>

        <TextBlock x:Name="HintText" Grid.Row="2" Margin="0,10,0,0" Foreground="Gray"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
